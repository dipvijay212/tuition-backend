# Neon Postgres: pooled URL for the app, direct URL for migrations.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require

PORT=4000
# Shared secret with the Next.js app (same value in its .env). Generate: openssl rand -hex 32
API_INTERNAL_KEY=generate-a-long-random-string
# Frontend URL used in email links (invites, password reset)
SITE_URL=http://localhost:3100
# Where uploaded files are stored (local disk)
STORAGE_DIR=./uploads
CRON_SECRET=change-me
# Postgres connections per API process (Neon pooled URL handles many).
DB_POOL_MAX=20

# SMTP (Nodemailer). For Gmail use smtp.gmail.com:587 and a 16-character App Password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME="Tuition Management"
SMTP_FROM_EMAIL=
